rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public tours and destinations collections: read and write access for CMS & Seeding
    match /tours/{tourId} {
      allow read, write: if true;
    }

    match /destinations/{destId} {
      allow read, write: if true;
    }

    // Bookings collection:
    // Any public user can create a booking request if required fields are valid strings
    // Read/update/delete allowed for management
    match /bookings/{bookingId} {
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.customerEmail is string;
      allow read, update, delete: if true;
    }

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
